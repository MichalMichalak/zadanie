# Copy to .env (cp .env.example .env) and adjust as needed.
# Committed template; the real .env is git-ignored.
# Compose reads this file automatically (project directory = dev-env/).
# Overrides from the shell environment take precedence over these values.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=coupons
MYSQL_USER=coupons
MYSQL_PASSWORD=coupons
MYSQL_PORT=3306

# --- Redis ---
REDIS_PASSWORD=redis
REDIS_PORT=6379
